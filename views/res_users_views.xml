<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <!-- Odoo 19: auth_oauth no longer ships its own view (no oauth_provider_id
                 anchor available anymore), so inherit the core user form instead and
                 anchor on the always-present "login" field. -->
            <field name="login" position="after">
                <field name="disable_password_login" />
            </field>
        </field>
    </record>
</odoo>
